@model LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    var returnUrl = Context.Request.Query["ReturnUrl"];
}

<div class="auth-section">
    <div class="auth-card fade-up">
        <span class="brand-mark">N</span>
        <h1 class="auth-title">Bon retour</h1>
        <p class="auth-subtitle">Connectez-vous pour suivre vos commandes et retrouver votre panier.</p>

        <form asp-route-returnurl="@returnUrl" method="post">
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="vous@exemple.com" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Votre mot de passe" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-brand w-100 py-2">Se connecter</button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            Pas encore de compte ?
            <a asp-action="Register" class="fw-semibold text-decoration-none">Créer un compte</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
