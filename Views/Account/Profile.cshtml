@model ProfileViewModel
@{
    ViewData["Title"] = "Mon profil";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var displayName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Substring(0, 1).ToUpperInvariant();
}

<div class="page-head">
    <div>
        <span class="eyebrow">Compte</span>
        <h1 class="page-title">Mon profil</h1>
        <p class="page-subtitle">Gérez vos informations de connexion et la sécurité de votre compte.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Continuer mes achats</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel h-100">
            <div class="panel-body text-center profile-summary">
                <span class="profile-avatar">@initial</span>
                <h2 class="profile-name">@displayName</h2>
                <p class="text-muted small mb-3">Membre NovaShop</p>

                @if (roles.Any())
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                        @foreach (var role in roles)
                        {
                            <span class="badge role-badge">@role</span>
                        }
                    </div>
                }

                <div class="profile-links">
                    <a asp-controller="Panier" asp-action="Orders">
                        <span>Mes commandes</span>
                        <span aria-hidden="true">→</span>
                    </a>
                    <a asp-action="ChangePassword">
                        <span>Changer le mot de passe</span>
                        <span aria-hidden="true">→</span>
                    </a>
                    <a asp-controller="Panier" asp-action="Index">
                        <span>Mon panier</span>
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="panel mb-4">
            <div class="panel-header">Informations du compte</div>
            <div class="panel-body">
                <form method="post" asp-action="Profile">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text">Cette adresse sert également d'identifiant de connexion.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password"
                               placeholder="Requis uniquement pour changer d'e-mail" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        <div class="form-text">Confirmez votre identité avant de modifier l'adresse e-mail.</div>
                    </div>

                    <button type="submit" class="btn btn-brand">Enregistrer les modifications</button>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">Sécurité</div>
            <div class="panel-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="fw-bold">Mot de passe</div>
                    <p class="text-muted small mb-0">Utilisez un mot de passe unique d'au moins 6 caractères.</p>
                </div>
                <a class="btn btn-soft" asp-action="ChangePassword">Modifier le mot de passe</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
