@using tp2.ViewModels
@model List<UserRoleViewModel>
@{
    ViewData["Title"] = "Utilisateurs du rôle";
    var roleId = ViewBag.roleId;
}

<ul class="breadcrumb-lite">
    <li><a asp-action="ListRoles">Rôles</a></li>
    <li>Utilisateurs</li>
</ul>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-header">Ajouter ou retirer des utilisateurs</div>
            <div class="panel-body">
                <form method="post">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check d-flex align-items-center gap-2 py-2 border-bottom">
                            <input type="hidden" asp-for="@Model[i].UserId" />
                            <input type="hidden" asp-for="@Model[i].UserName" />
                            <input asp-for="@Model[i].IsSelected" class="form-check-input mt-0" />
                            <label class="form-check-label fw-semibold" asp-for="@Model[i].IsSelected">
                                @Model[i].UserName
                            </label>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-brand px-4">Mettre à jour</button>
                        <a class="btn btn-outline-secondary" asp-action="EditRole" asp-route-id="@roleId">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
