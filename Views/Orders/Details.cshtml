@model Order
@{
    ViewData["Title"] = $"Commande #{Model.Id:D5}";
    var statuses = ViewBag.Statuses as string[] ?? OrderStatuses.All;
    var paymentLabel = Model.PaymentMethod == "Paypal" ? "PayPal" : "Carte de crédit";
}

<ul class="breadcrumb-lite">
    <li><a asp-action="Index">Commandes</a></li>
    <li>#@Model.Id.ToString("D5")</li>
</ul>

<div class="page-head">
    <div>
        <span class="eyebrow">Administration</span>
        <h1 class="page-title">Commande #@Model.Id.ToString("D5")</h1>
        <p class="page-subtitle">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="status-badge @OrderStatuses.GetBadgeClass(Model.Status)">
        @OrderStatuses.GetLabel(Model.Status)
    </span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel mb-4">
            <div class="panel-header">Articles commandés</div>
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Produit</th>
                            <th class="text-center">Quantité</th>
                            <th class="text-end">Prix unitaire</th>
                            <th class="text-end pe-4">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N2") DT</td>
                                <td class="text-end fw-bold pe-4">@item.TotalPrice.ToString("N2") DT</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end pe-4">@Model.TotalAmount.ToString("N2") DT</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">Informations client</div>
            <div class="panel-body">
                <ul class="detail-list">
                    <li>
                        <span>Client</span>
                        <span>@Model.CustomerName</span>
                    </li>
                    <li>
                        <span>E-mail</span>
                        <span>@Model.Email</span>
                    </li>
                    <li>
                        <span>Paiement</span>
                        <span>@paymentLabel</span>
                    </li>
                    <li>
                        <span>Adresse de livraison</span>
                        <span>@Model.Address</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-header">Traitement</div>
            <div class="panel-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label class="form-label" for="status">Statut de la commande</label>
                    <select id="status" name="status" class="form-select mb-3">
                        @foreach (var status in statuses)
                        {
                            <option value="@status" selected="@(status == Model.Status)">
                                @OrderStatuses.GetLabel(status)
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-brand w-100">Mettre à jour</button>
                </form>

                <a class="btn btn-outline-secondary w-100 mt-2" asp-action="Index">Retour aux commandes</a>
            </div>
        </div>
    </div>
</div>
