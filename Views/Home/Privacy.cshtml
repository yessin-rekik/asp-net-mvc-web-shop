@{
    ViewData["Title"] = "Confidentialité";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-body p-4 p-lg-5">
                <span class="eyebrow">Informations</span>
                <h1 class="page-title mb-3">Politique de confidentialité</h1>
                <p class="text-muted">
                    NovaShop est une boutique de démonstration. Les informations collectées servent
                    uniquement au traitement des commandes et à l'amélioration de votre expérience.
                </p>

                <div class="form-section-title">Données collectées</div>
                <p>
                    Lors de la création d'un compte, nous enregistrons votre adresse e-mail et les
                    informations nécessaires à la livraison. Les mots de passe sont stockés de manière
                    sécurisée par ASP.NET Core Identity.
                </p>

                <div class="form-section-title">Paiement</div>
                <p>
                    Le paiement est simulé dans cette version. Aucune donnée bancaire réelle n'est
                    demandée ni conservée.
                </p>

                <div class="form-section-title">Vos droits</div>
                <p class="mb-0">
                    Vous pouvez consulter l'historique de vos commandes et nous contacter pour toute
                    demande relative à vos données personnelles.
                </p>
            </div>
        </div>
    </div>
</div>
