<div class="chatbot" id="chatbot">
    <button type="button" class="chatbot-toggle" id="chatbotToggle"
            aria-label="Ouvrir l'assistant NovaShop" aria-controls="chatbotPanel" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 12a8.5 8.5 0 0 1-8.5 8.5H6l-3 2v-5.2A8.5 8.5 0 1 1 21 12Z" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-linecap="round" stroke-width="2.4" />
        </svg>
        <span class="chatbot-ping" aria-hidden="true"></span>
    </button>

    <section class="chatbot-panel" id="chatbotPanel" aria-label="Assistant NovaShop" aria-hidden="true">
        <header class="chatbot-head">
            <div class="chatbot-identity">
                <span class="chatbot-avatar">N</span>
                <span>
                    <strong>Assistant NovaShop</strong>
                    <span class="chatbot-status"><i aria-hidden="true"></i> En ligne</span>
                </span>
            </div>
            <button type="button" class="chatbot-close" id="chatbotClose" aria-label="Fermer l'assistant">×</button>
        </header>

        <div class="chatbot-messages" id="chatbotMessages" role="log" aria-live="polite" aria-relevant="additions">
            <div class="chat-message chat-bot">
                <div class="chat-bubble">
                    Bonjour ! Je suis l'assistant NovaShop. Je peux vous aider à trouver un produit,
                    suivre une commande ou répondre à vos questions sur la livraison et le paiement.
                </div>
            </div>
            <div class="chat-suggestions">
                <button type="button" data-suggestion="Voir les produits">Voir les produits</button>
                <button type="button" data-suggestion="Livraison">Livraison</button>
                <button type="button" data-suggestion="Modes de paiement">Modes de paiement</button>
                <button type="button" data-suggestion="Suivre ma commande">Suivre ma commande</button>
            </div>
        </div>

        <form class="chatbot-form" id="chatbotForm" autocomplete="off">
            <input type="text" id="chatbotInput" name="message" maxlength="500"
                   placeholder="Posez votre question..." aria-label="Votre message" />
            <button type="submit" id="chatbotSend" aria-label="Envoyer le message">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 3 10.5 13.5M21 3l-6.5 18-4-8-8-4L21 3Z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </form>
    </section>
</div>
