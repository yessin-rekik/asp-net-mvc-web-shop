@{
    ViewData["Title"] = "Introuvable";
    var message = ViewBag.ErrorMessage as string;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel empty-state">
            <div class="empty-icon" style="background:#fffbeb;color:#b45309;">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5M8.5 11h5" stroke-linecap="round" />
                </svg>
            </div>
            <h1 class="page-title mb-2">Élément introuvable</h1>
            <p>@(string.IsNullOrWhiteSpace(message) ? "La ressource demandée n'existe pas ou a été supprimée." : message)</p>
            <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
        </div>
    </div>
</div>
