@model tp2.Models.Category
@{
    ViewData["Title"] = "Modifier la catégorie";
}

<ul class="breadcrumb-lite">
    <li><a asp-action="Index">Catégories</a></li>
    <li><a asp-action="Details" asp-route-id="@Model.CategoryId">@Model.CategoryName</a></li>
    <li>Modifier</li>
</ul>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel">
            <div class="panel-body p-4">
                <span class="eyebrow">Administration</span>
                <h1 class="page-title mb-1">Modifier la catégorie</h1>
                <p class="page-subtitle mb-4">Renommez cet univers du catalogue.</p>

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" autofocus />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-brand px-4">Enregistrer</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
