@model Order
@{
    ViewData["Title"] = "Commande confirmée";
    var paymentLabel = Model.PaymentMethod == "Paypal" ? "PayPal" : "Carte de crédit";
}

<div class="panel fade-up">
    <div class="order-hero">
        <div class="order-check">
            <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2.4">
                <path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <span class="eyebrow">Merci @Model.CustomerName</span>
        <h1 class="page-title">Votre commande est confirmée</h1>
        <p class="text-muted mb-2">Nous avons bien enregistré votre commande. Un récapitulatif est disponible ci-dessous.</p>
        <span class="order-ref">Commande #@Model.Id.ToString("D5")</span>
        <span class="status-badge @OrderStatuses.GetBadgeClass(Model.Status)">
            @OrderStatuses.GetLabel(Model.Status)
        </span>
    </div>

    <div class="panel-body pt-0">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="text-muted small">Date</div>
                    <div class="fw-bold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="text-muted small">Paiement</div>
                    <div class="fw-bold">@paymentLabel</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="text-muted small">Articles</div>
                    <div class="fw-bold">@Model.Items.Sum(i => i.Quantity)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 border bg-light h-100">
                    <div class="text-muted small">Total</div>
                    <div class="fw-bold text-success">@Model.TotalAmount.ToString("N2") DT</div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <div class="form-section-title mb-2">Adresse de livraison</div>
            <p class="mb-0">@Model.Address</p>
            <p class="text-muted small mb-0">@Model.Email</p>
        </div>

        <div class="form-section-title">Détail de la commande</div>
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-end">Prix unitaire</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.Price.ToString("N2") DT</td>
                            <td class="text-end fw-bold">@item.TotalPrice.ToString("N2") DT</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">@Model.TotalAmount.ToString("N2") DT</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-brand" asp-controller="Product" asp-action="Index">Continuer mes achats</a>
            <a class="btn btn-outline-secondary" asp-controller="Panier" asp-action="Orders">Mes commandes</a>
        </div>
    </div>
</div>
