@model tp2.Models.Product
@{
    ViewData["Title"] = "Supprimer le produit";
    var imagePath = string.IsNullOrWhiteSpace(Model.Image) ? Url.Content("~/images/placeholder.svg") : Url.Content("~/images/" + Model.Image);
}

<ul class="breadcrumb-lite">
    <li><a asp-action="Index">Produits</a></li>
    <li><a asp-action="Details" asp-route-id="@Model.ProductId">@Model.Name</a></li>
    <li>Supprimer</li>
</ul>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-body p-4 text-center">
                <div class="empty-icon" style="background:#fef2f2;color:#b91c1c;">
                    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h1 class="page-title mb-2">Supprimer ce produit ?</h1>
                <p class="text-muted">Cette action est définitive et retirera le produit du catalogue.</p>

                <div class="d-flex align-items-center gap-3 text-start p-3 my-4 rounded-3 border bg-light">
                    <img src="@imagePath" alt="@Model.Name" class="cart-thumb" />
                    <div>
                        <div class="fw-bold">@Model.Name</div>
                        <div class="text-muted small">@(Model.Category?.CategoryName ?? "Sans catégorie") · @Model.QteStock en stock</div>
                        <div class="fw-bold mt-1">@Model.Price.ToString("N2") DT</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
                    <input type="hidden" asp-for="ProductId" />
                    <button type="submit" class="btn btn-danger px-4">Oui, supprimer</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
